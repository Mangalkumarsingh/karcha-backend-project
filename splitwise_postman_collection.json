{
  "info": {
    "name": "Splitwise Group Expense Sharing Backend API",
    "description": "Complete Postman collection for Splitwise clone backend in Spring Boot 3.4.1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "YOUR_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "groupId",
      "value": "YOUR_GROUP_UUID",
      "type": "string"
    },
    {
      "key": "invitationId",
      "value": "YOUR_INVITATION_UUID",
      "type": "string"
    },
    {
      "key": "expenseId",
      "value": "YOUR_EXPENSE_UUID",
      "type": "string"
    },
    {
      "key": "settlementId",
      "value": "YOUR_SETTLEMENT_UUID",
      "type": "string"
    },
    {
      "key": "userA_Id",
      "value": "YOUR_USER_A_UUID",
      "type": "string"
    },
    {
      "key": "userB_Id",
      "value": "YOUR_USER_B_UUID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Module A: Authentication",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "request"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "verify"]
            }
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"googleToken\": \"YOUR_GOOGLE_ID_TOKEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google"]
            }
          }
        }
      ]
    },
    {
      "name": "Module B: User Profile",
      "item": [
        {
          "name": "Get Current User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"profileImageUrl\": \"https://example.com/avatar.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            }
          }
        },
        {
          "name": "Get My Pending Invitations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me", "invitations"]
            }
          }
        }
      ]
    },
    {
      "name": "Module C: Group Management",
      "item": [
        {
          "name": "Create Group",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Goa Trip\",\n  \"description\": \"Friends vacation expenses\",\n  \"currency\": \"INR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups"]
            }
          }
        },
        {
          "name": "Get My Groups",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups"]
            }
          }
        },
        {
          "name": "Get Group Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}"]
            }
          }
        },
        {
          "name": "Update Group",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Goa Trip 2026\",\n  \"description\": \"Updated vacation description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}"]
            }
          }
        },
        {
          "name": "Delete Group (Soft Delete)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Module D: Group Members and Invitations",
      "item": [
        {
          "name": "Invite Member by Phone",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "invitations"]
            }
          }
        },
        {
          "name": "Accept Invitation",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invitations/{{invitationId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invitations", "{{invitationId}}", "accept"]
            }
          }
        },
        {
          "name": "Reject Invitation",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invitations/{{invitationId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invitations", "{{invitationId}}", "reject"]
            }
          }
        },
        {
          "name": "Get Group Members",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "members"]
            }
          }
        },
        {
          "name": "Remove Member or Leave Group",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/members/{{userB_Id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "members", "{{userB_Id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Module E: Shared Expense Management",
      "item": [
        {
          "name": "Add Shared Expense",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hotel Booking\",\n  \"description\": \"Hotel for Goa trip\",\n  \"amount\": 4000.00,\n  \"paidByUserId\": \"{{userA_Id}}\",\n  \"splitType\": \"EQUAL\",\n  \"participantIds\": [\n    \"{{userA_Id}}\",\n    \"{{userB_Id}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "expenses"]
            }
          }
        },
        {
          "name": "Get Group Expenses (Paginated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/expenses?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "expenses"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get Expense Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "expenses", "{{expenseId}}"]
            }
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hotel Booking Updated\",\n  \"description\": \"Extended stay in Goa\",\n  \"amount\": 4500.00,\n  \"paidByUserId\": \"{{userA_Id}}\",\n  \"splitType\": \"EQUAL\",\n  \"participantIds\": [\n    \"{{userA_Id}}\",\n    \"{{userB_Id}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "expenses", "{{expenseId}}"]
            }
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/expenses/{{expenseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "expenses", "{{expenseId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Module F: Group Balances",
      "item": [
        {
          "name": "Get Group Balances and Transfers",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/balances",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "balances"]
            }
          }
        }
      ]
    },
    {
      "name": "Module G: Settlement Management",
      "item": [
        {
          "name": "Record Settlement",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromUserId\": \"{{userB_Id}}\",\n  \"toUserId\": \"{{userA_Id}}\",\n  \"amount\": 1000.00,\n  \"paymentMethod\": \"UPI\",\n  \"note\": \"Hotel expense settled via UPI\",\n  \"idempotencyKey\": \"settle-uuid-1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/settlements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "settlements"]
            }
          }
        },
        {
          "name": "List Settlements (Paginated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/settlements?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "settlements"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Confirm Settlement",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/settlements/{{settlementId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "settlements", "{{settlementId}}", "confirm"]
            }
          }
        },
        {
          "name": "Reject Settlement",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/groups/{{groupId}}/settlements/{{settlementId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "groups", "{{groupId}}", "settlements", "{{settlementId}}", "reject"]
            }
          }
        }
      ]
    }
  ]
